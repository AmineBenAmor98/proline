ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://proline:proline@localhost:5432/proline

# Admin sign-in — change both before the site is public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=proline
SECRET_KEY=change-me-to-a-long-random-string

# Mail. SMTP rather than a vendor API, so changing provider is these values and
# a redeploy -- see app/services/mailer.py. Amazon SES in Montreal:
#   SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
# with SES SMTP credentials, which are NOT your AWS access keys.
# Empty in local dev: notifications are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# What the client sees, and where their reply lands. The reply address is a real
# mailbox on the domain; the sending host above is not.
MAIL_FROM=Proline Cleaning Solutions <contact@proline-cleaningsolutions.com>
MAIL_REPLY_TO=contact@proline-cleaningsolutions.com

# Where new-lead alerts go (your own inbox).
# The company mailbox, not a personal address -- see infra/IDENTITIES.md §4.
NOTIFY_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# Where the built site is served from. Both compose files set it; a no-Docker run
# leaves it empty, and app/main.py then falls back to ../frontend.
FRONTEND_DIR=
